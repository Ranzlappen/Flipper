{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run validate)",
      "Bash(npm run smoke)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(node ./scripts/validate.mjs)",
      "Bash(node ./scripts/smoke.mjs)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(find . -name *.fam)",
      "Bash(find C-Apps -type f*)",
      "Bash(find JS-Apps -type f*)",
      "Bash(ls)",
      "Bash(ls:*)",
      "Bash(cat .momentum-sdk-version)",
      "Bash(ufbt --help)",
      "Bash(ufbt version)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(npm publish:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
