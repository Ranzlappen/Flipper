{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "noLib": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "badusb": ["node_modules/@next-flip/fz-sdk-mntm/badusb"],
      "blebeacon": ["node_modules/@next-flip/fz-sdk-mntm/blebeacon"],
      "event_loop": ["node_modules/@next-flip/fz-sdk-mntm/event_loop"],
      "flipper": ["node_modules/@next-flip/fz-sdk-mntm/flipper"],
      "gpio": ["node_modules/@next-flip/fz-sdk-mntm/gpio"],
      "gui": ["node_modules/@next-flip/fz-sdk-mntm/gui"],
      "gui/*": ["node_modules/@next-flip/fz-sdk-mntm/gui/*"],
      "i2c": ["node_modules/@next-flip/fz-sdk-mntm/i2c"],
      "math": ["node_modules/@next-flip/fz-sdk-mntm/math"],
      "notification": ["node_modules/@next-flip/fz-sdk-mntm/notification"],
      "serial": ["node_modules/@next-flip/fz-sdk-mntm/serial"],
      "spi": ["node_modules/@next-flip/fz-sdk-mntm/spi"],
      "storage": ["node_modules/@next-flip/fz-sdk-mntm/storage"],
      "subghz": ["node_modules/@next-flip/fz-sdk-mntm/subghz"],
      "usbdisk": ["node_modules/@next-flip/fz-sdk-mntm/usbdisk"],
      "vgm": ["node_modules/@next-flip/fz-sdk-mntm/vgm"]
    }
  },
  "include": [
    "node_modules/@next-flip/fz-sdk-mntm/global.d.ts",
    "templates/**/*",
    "examples/**/*",
    "src/**/*"
  ],
  "exclude": ["dist", "build"]
}
