# Optional environment variables for local tooling.
# Copy this file to `.env` and edit. The Flipper itself does NOT read this file -
# these only configure the local TypeScript / validation tooling on your computer.

# Path to your mounted Flipper SD card (used by helper scripts if you add any).
# Examples:
#   FLIPPER_SD=/Volumes/FLIPPER          # macOS
#   FLIPPER_SD=/run/media/user/FLIPPER   # Linux
#   FLIPPER_SD=E:\                       # Windows
FLIPPER_SD=

# Default destination folder on the SD card for JS scripts.
SCRIPTS_DIR=/ext/apps/Scripts
