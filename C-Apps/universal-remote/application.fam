# Flipper Application Manifest (FAM) for the "Universal Remote" app.
#
# Multi-remote app: each profile maps the six hardware buttons (UP/DOWN/LEFT/
# RIGHT/OK/BACK) to a saved Sub-GHz `.sub` file or a named IR signal from an
# `.ir` file. The four directional buttons additionally support an
# independently-mappable long-press binding. Profiles live as one file per
# remote in /ext/apps_data/universal_remote/remotes/<name>.urcfg.
#
# `appid` doubles as the .fap filename and must match the folder name
# (after kebab→snake normalisation: universal-remote → universal_remote).
App(
    appid="universal_remote",
    name="Universal Remote",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="universal_remote_app",
    requires=["gui", "storage"],
    stack_size=8 * 1024,
    fap_category="Tools",
    fap_icon="icon.png",
    fap_author="Momentum App Framework",
    fap_version="0.2",
    fap_description="Multi-profile universal remote with short and long-press bindings for Sub-GHz and Infrared signals.",
    fap_weburl="https://github.com/Ranzlappen/Flipper",
)
